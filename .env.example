# PayPilot Environment Configuration
# Everything runs safely out of the box in DEMO mode even with no API keys.
# To connect to live PayPal Sandbox and Gemini/Claude, fill in your credentials below.

# PayPal Sandbox Credentials (https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id_for_signature_verification

# LLM Planner Credentials
# PayPilot has a zero-latency deterministic offline fallback for offline/demo scenarios.
# If provided, real LLM calls will plan custom user requests.
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false
